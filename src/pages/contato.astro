---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import {
  MapPin,
  Phone,
  Mail,
  Clock,
  MessageCircle,
  Navigation,
  Send
} from '@lucide/astro';

const whatsappNumber = siteConfig.contact.whatsapp;
const emailDestination = siteConfig.contact.email;
---

<Layout title="Contato">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-extrabold text-orange-400 mb-4">Fale Conosco</h1>
      <p class="text-slate-300 max-w-xl mx-auto">
        Tem alguma dúvida, sugestão ou precisa falar com a gerência do {siteConfig.name}? Envie uma mensagem ou use nossos canais diretos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Coluna 1 e 2: Formulário de Contato -->
      <div class="lg:col-span-2 bg-slate-800/60 p-8 rounded-2xl border border-slate-700/60 backdrop-blur-xs">
        <h2 class="text-2xl font-bold text-white mb-2">Envie uma Mensagem</h2>
        <p class="text-sm text-slate-400 mb-6">
          Preencha os campos abaixo para iniciar o atendimento direto via WhatsApp ou E-mail.
        </p>
        
        <form id="contact-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-300 mb-2">Nome Completo</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Seu nome"
                class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-xl focus:outline-none focus:border-orange-500 text-white transition"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-2">E-mail ou Telefone</label>
              <input
                type="text"
                id="email"
                name="email"
                required
                placeholder="seu@email.com ou (83) 99999-9999"
                class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-xl focus:outline-none focus:border-orange-500 text-white transition"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-slate-300 mb-2">Assunto</label>
            <select
              id="subject"
              name="subject"
              class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-xl focus:outline-none focus:border-orange-500 text-white transition"
            >
              <option value="Dúvidas Gerais">Dúvidas Gerais / Abastecimento</option>
              <option value="Pousada do Sol">Reservas / Pousada do Sol</option>
              <option value="Troca de Óleo">Troca de Óleo / Serviços Automotivos</option>
              <option value="Conveniência Hora H">Conveniência Hora H</option>
              <option value="Parcerias / Comercial">Parcerias / Comercial / Gerência</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-slate-300 mb-2">Mensagem</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Escreva sua mensagem..."
              class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-xl focus:outline-none focus:border-orange-500 text-white transition resize-none"
            ></textarea>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <button
              type="submit"
              data-channel="whatsapp"
              class="flex-1 inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3.5 rounded-xl transition shadow-lg shadow-emerald-950/30 cursor-pointer"
            >
              <MessageCircle class="w-5 h-5" />
              <span>Enviar pelo WhatsApp</span>
            </button>

            <button
              type="submit"
              data-channel="email"
              class="inline-flex items-center justify-center gap-2 bg-slate-700 hover:bg-slate-600 text-white font-semibold px-6 py-3.5 rounded-xl transition cursor-pointer"
            >
              <Send class="w-4 h-4" />
              <span>Enviar por E-mail</span>
            </button>
          </div>
        </form>

        <!-- Mensagem de Sucesso Embutida -->
        <div
          id="success-message"
          class="hidden mt-6 p-4 bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 rounded-xl text-center text-sm"
        >
          Redirecionando sua mensagem para o canal selecionado! Caso a janela não tenha aberto, utilize os contatos diretos ao lado.
        </div>
      </div>

      <!-- Coluna 3: Informações de Contato -->
      <div class="space-y-6">
        <div class="bg-slate-800/60 p-6 rounded-2xl border border-slate-700/60 flex items-start gap-4">
          <div class="bg-blue-500/15 p-3 rounded-xl text-blue-400 shrink-0">
            <MapPin class="w-6 h-6" />
          </div>
          <div>
            <h3 class="font-bold text-white mb-1">Endereço</h3>
            <p class="text-sm text-slate-300 leading-relaxed mb-3">
              Av. Mar Vermelho, 499<br />Intermares, Cabedelo - PB<br />CEP 58102-120
            </p>
            <div class="flex flex-wrap gap-2">
              <a
                href={siteConfig.mapsLink}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold bg-blue-600/20 text-blue-300 border border-blue-500/30 px-3 py-1.5 rounded-lg hover:bg-blue-600/30 transition"
              >
                Google Maps
              </a>
              <a
                href={siteConfig.wazeLink || "https://waze.com/ul?q=Av.%20Mar%20Vermelho%2C%20499%20-%20Intermares%2C%20Cabedelo"}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-semibold bg-slate-700 text-slate-200 px-3 py-1.5 rounded-lg hover:bg-slate-600 transition"
              >
                <Navigation class="w-3 h-3 text-orange-400" /> Waze
              </a>
            </div>
          </div>
        </div>

        <div class="bg-slate-800/60 p-6 rounded-2xl border border-slate-700/60 flex items-start gap-4">
          <div class="bg-emerald-500/15 p-3 rounded-xl text-emerald-400 shrink-0">
            <Phone class="w-6 h-6" />
          </div>
          <div>
            <h3 class="font-bold text-white mb-1">Telefone / WhatsApp</h3>
            <div class="text-sm text-slate-300 space-y-1">
              <p>
                <a href={`https://wa.me/${siteConfig.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="hover:text-white transition">
                  {siteConfig.contact.phone} (WhatsApp / Fixo)
                </a>
              </p>
              <p>
                <a href="tel:+5583999831003" class="hover:text-white transition">
                  (83) 99983-1003
                </a>
              </p>
            </div>
          </div>
        </div>

        <div class="bg-slate-800/60 p-6 rounded-2xl border border-slate-700/60 flex items-start gap-4">
          <div class="bg-purple-500/15 p-3 rounded-xl text-purple-400 shrink-0">
            <Mail class="w-6 h-6" />
          </div>
          <div>
            <h3 class="font-bold text-white mb-1">E-mail Direto</h3>
            <a href={`mailto:${siteConfig.contact.email}`} class="text-sm text-slate-300 hover:text-white transition break-all">
              {siteConfig.contact.email}
            </a>
          </div>
        </div>

        <div class="bg-slate-800/60 p-6 rounded-2xl border border-slate-700/60 flex items-start gap-4">
          <div class="bg-amber-500/15 p-3 rounded-xl text-amber-400 shrink-0">
            <Clock class="w-6 h-6" />
          </div>
          <div class="w-full">
            <h3 class="font-bold text-white mb-2">Horários de Funcionamento</h3>
            <ul class="text-xs sm:text-sm text-slate-300 space-y-2">
              <li class="flex justify-between gap-2 border-b border-slate-700/60 pb-1.5">
                <strong class="text-white">Conveniência {siteConfig.businesses.conveniencia.name}:</strong>
                <span class="text-right">{siteConfig.businesses.conveniencia.hours}</span>
              </li>
              <li class="flex justify-between gap-2 border-b border-slate-700/60 pb-1.5">
                <strong class="text-white">Troca de Óleo:</strong>
                <span class="text-right">{siteConfig.businesses.trocaOleo.hours}</span>
              </li>
              <li class="flex justify-between gap-2 border-b border-slate-700/60 pb-1.5">
                <strong class="text-white">Lavanderia:</strong>
                <span class="text-right">{siteConfig.businesses.lavanderia.hours}</span>
              </li>
              <li class="flex justify-between gap-2">
                <strong class="text-white">Pousada do Sol:</strong>
                <span class="text-right">Recepção 08:00 às 23:00</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ whatsappNumber, emailDestination }}>
  const form = document.getElementById('contact-form');
  const successMessage = document.getElementById('success-message');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const submitter = e.submitter;
    const channel = submitter?.getAttribute('data-channel') || 'whatsapp';

    const name = document.getElementById('name')?.value || '';
    const email = document.getElementById('email')?.value || '';
    const subject = document.getElementById('subject')?.value || '';
    const message = document.getElementById('message')?.value || '';

    if (channel === 'email') {
      const mailtoSubject = `[Site Posto Intermares] ${subject} - ${name}`;
      const mailtoBody = `Nome: ${name}\nContato: ${email}\nAssunto: ${subject}\n\nMensagem:\n${message}`;
      window.location.href = `mailto:${emailDestination}?subject=${encodeURIComponent(mailtoSubject)}&body=${encodeURIComponent(mailtoBody)}`;
    } else {
      const texto =
        `Olá! Enviei uma mensagem pelo site do *Posto Intermares*:\n\n` +
        `👤 *Nome:* ${name}\n` +
        `📞 *Contato:* ${email}\n` +
        `📌 *Assunto:* ${subject}\n\n` +
        `💬 *Mensagem:*\n${message}`;
      const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(texto)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    }

    if (successMessage) {
      successMessage.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        successMessage.classList.add('hidden');
      }, 6000);
    }
  });
</script>