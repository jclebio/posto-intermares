---
import Layout from '../layouts/Layout.astro';
import { MapPin, Phone, Mail, Clock } from '@lucide/astro';
---

<Layout title="Contato">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-extrabold text-blue-500 mb-4">Fale Conosco</h1>
      <p class="text-slate-400 max-w-xl mx-auto">
        Tem alguma dúvida, sugestão ou precisa falar com a gerência do Posto Intermares? Envie uma mensagem ou use nossos canais diretos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Coluna 1 e 2: Formulário de Contato -->
      <div class="lg:col-span-2 bg-slate-800/50 p-8 rounded-2xl border border-slate-700/50 backdrop-blur-sm">
        <h2 class="text-2xl font-bold text-white mb-6">Envie uma Mensagem</h2>
        
        <form class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-slate-300 mb-2">Nome Completo</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg focus:outline-none focus:border-blue-500 text-white transition" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-2">E-mail</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg focus:outline-none focus:border-blue-500 text-white transition" />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-slate-300 mb-2">Assunto</label>
            <select id="subject" name="subject" class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg focus:outline-none focus:border-blue-500 text-white transition">
              <option value="geral">Dúvidas Gerais</option>
              <option value="pousada">Reservas / Pousada do Sol</option>
              <option value="servicos">Serviços Automotivos</option>
              <option value="comercial">Parcerias / Comercial</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-slate-300 mb-2">Mensagem</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-lg focus:outline-none focus:border-blue-500 text-white transition resize-none"></textarea>
          </div>

          <button type="submit" class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-bold px-8 py-3 rounded-lg transition shadow-lg shadow-blue-600/20">
            Enviar Mensagem
          </button>
        </form>
      </div>

      <!-- Coluna 3: Informações de Contato -->
      <div class="space-y-6">
        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700/50 flex items-start gap-4">
          <div class="bg-blue-500/10 p-3 rounded-xl text-blue-500 shrink-0">
            <MapPin class="w-6 h-6" />
          </div>
          <div>
            <h3 class="font-bold text-white mb-1">Endereço</h3>
            <p class="text-sm text-slate-400 leading-relaxed">
              Av. Mar Vermelho, 499<br />Intermares, Cabedelo - PB<br />CEP 58102-120
            </p>
          </div>
        </div>

        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700/50 flex items-start gap-4">
          <div class="bg-green-500/10 p-3 rounded-xl text-green-500 shrink-0">
            <Phone class="w-6 h-6" />
          </div>
          <div>
            <h3 class="font-bold text-white mb-1">Telefone / WhatsApp</h3>
            <p class="text-sm text-slate-400">(83) 999831003<br/>(83) 32481517</p>
          </div>
        </div>

        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700/50 flex items-start gap-4">
          <div class="bg-purple-500/10 p-3 rounded-xl text-purple-500 shrink-0">
            <Mail class="w-6 h-6" />
          </div>
          <div>
            <h3 class="font-bold text-white mb-1">E-mail Direto</h3>
            <p class="text-sm text-slate-400">postointermares@uol.com.br</p>
          </div>
        </div>

        <div class="bg-slate-800/50 p-6 rounded-2xl border border-slate-700/50 flex items-start gap-4">
          <div class="bg-amber-500/10 p-3 rounded-xl text-amber-500 shrink-0">
            <Clock class="w-6 h-6" />
          </div>
          <div>
            <h3 class="font-bold text-white mb-1">Funcionamento</h3>
            <p class="text-sm text-slate-400 leading-relaxed">
              <strong>Posto:</strong> 24 Horas<br />
              <strong>Conveniência:</strong> 06h às 22h<br />
              <strong>Pousada:</strong> Recepção 08H às 23:00h
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

