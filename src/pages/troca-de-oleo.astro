---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import { Wrench, Droplet, Settings, ShieldCheck, Clock, MapPin, Car } from '@lucide/astro';

const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent("Olá! Gostaria de informações sobre o serviço de Troca de Óleo.")}`;
---

<Layout 
  title={siteConfig.businesses.trocaOleo.name}
  description="Serviço especializado de troca de óleo, filtros e fluidos de transmissão em Cabedelo. Atendemos linha leve, SUVs, utilitários a diesel e motocicletas."
>
  <!-- Hero Section -->
  <div class="bg-blue-900 py-16 border-b-4 border-orange-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <Wrench class="w-16 h-16 text-orange-500 mx-auto mb-6" />
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        {siteConfig.businesses.trocaOleo.name}
      </h1>
      <p class="text-xl text-blue-100 max-w-2xl mx-auto">
        Manutenção preventiva de confiança para o seu veículo. Lubrificantes de excelência e atendimento técnico qualificado.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col lg:flex-row gap-12 items-start">
      
      <!-- Conteúdo Principal -->
      <div class="flex-1 space-y-10">
        
        <section>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Nossos Serviços</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Serviço 1 -->
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4 hover:shadow-md transition">
              <Droplet class="w-8 h-8 text-orange-600 flex-shrink-0" />
              <div>
                <h3 class="font-bold text-lg mb-1">Óleo de Motor</h3>
                <p class="text-gray-600 text-sm">Troca de óleo mineral, semissintético e sintético, respeitando as especificações originais de cada montadora.</p>
              </div>
            </div>
            
            <!-- Serviço 2 -->
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4 hover:shadow-md transition">
              <Settings class="w-8 h-8 text-orange-600 flex-shrink-0" />
              <div>
                <h3 class="font-bold text-lg mb-1">Troca de Filtros</h3>
                <p class="text-gray-600 text-sm">Substituição de filtros de óleo, ar do motor, ar-condicionado (cabine) e combustível para máxima performance.</p>
              </div>
            </div>

            <!-- Serviço 3 -->
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4 hover:shadow-md transition">
              <Car class="w-8 h-8 text-orange-600 flex-shrink-0" />
              <div>
                <h3 class="font-bold text-lg mb-1">Fluidos Especiais</h3>
                <p class="text-gray-600 text-sm">Verificação e troca de fluidos de transmissão, freio e arrefecimento, essenciais para a vida útil do seu veículo.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Marcas e Especialidades -->
        <section class="bg-orange-50 border border-orange-200 rounded-2xl p-8 shadow-sm">
          <div class="flex items-center gap-3 mb-6">
            <ShieldCheck class="w-8 h-8 text-orange-600" />
            <h3 class="text-2xl font-bold text-gray-900">Qualidade e Precisão</h3>
          </div>
          <p class="text-gray-700 mb-6">
            Trabalhamos com linhas automotivas completas (linha leve e flex), <strong>SUVs e Utilitários a Diesel</strong>, e também temos experiência com filtros específicos para <strong>Motocicletas de alta cilindrada</strong>.
          </p>
          <div class="bg-white rounded-lg p-4 border border-orange-100">
            <p class="text-sm text-gray-600 font-medium">Marcas parceiras e compatibilidades que você pode encontrar aqui:</p>
            <p class="text-gray-800 font-bold mt-2">
              Lubrificantes YPF Elaion • Filtros Mahle • Tecfil • Wega • Hiflofiltro
            </p>
          </div>
        </section>
      </div>

      <!-- Barra Lateral Informativa -->
      <div class="w-full lg:w-1/3 space-y-6">
        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200">
          <h3 class="font-bold text-xl mb-6">Informações</h3>
          
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <Clock class="w-6 h-6 text-blue-600 mt-1" />
              <div>
                <h4 class="font-bold text-gray-900">Horário de Atendimento</h4>
                <p class="text-gray-600 text-sm mt-1">{siteConfig.businesses.trocaOleo.hours}</p>
              </div>
            </li>
            
            <li class="flex items-start gap-4">
              <MapPin class="w-6 h-6 text-blue-600 mt-1" />
              <div>
                <h4 class="font-bold text-gray-900">Localização</h4>
                <p class="text-gray-600 text-sm mt-1">Estrutura anexa ao {siteConfig.name}</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Botão de Orçamento -->
        <a 
          href={whatsappUrl}
          target="_blank" 
          rel="noopener noreferrer"
          class="block w-full bg-green-600 text-white text-center px-6 py-4 rounded-xl font-bold hover:bg-green-700 transition shadow-sm hover:shadow-md"
        >
          Consultar Valores via WhatsApp
        </a>
      </div>

    </div>
  </div>
</Layout>