---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import {
  Wrench,
  Droplet,
  Settings,
  ShieldCheck,
  Clock,
  MapPin,
  Car,
  MessageCircle,
  CheckCircle2
} from '@lucide/astro';

const whatsappNumber = siteConfig.contact.whatsapp;
---

<Layout 
  title={siteConfig.businesses.trocaOleo.name}
  description="Serviço especializado de troca de óleo, filtros e fluidos de transmissão em Cabedelo. Atendemos linha leve, SUVs, utilitários a diesel e motocicletas."
>
  <!-- Hero Section -->
  <section class="bg-zinc-900 py-16 border-b-4 border-red-500 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex p-4 rounded-2xl bg-red-500/15 border border-red-400/30 mb-6">
        <Wrench class="w-12 h-12 text-red-400" />
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        {siteConfig.businesses.trocaOleo.name}
      </h1>
      <p class="text-xl text-zinc-300 max-w-2xl mx-auto leading-relaxed">
        Manutenção preventiva de confiança para o seu veículo. Lubrificantes de excelência e atendimento técnico qualificado.
      </p>
    </div>
  </section>

  <!-- Conteúdo Principal -->
  <section class="bg-white text-gray-900 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-12 items-start">
        
        <!-- Coluna Esquerda: Serviços e Marcas -->
        <div class="flex-1 space-y-10">
          
          <div>
            <h2 class="text-3xl font-bold text-gray-900 mb-6">Nossos Serviços</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Serviço 1 -->
              <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs flex items-start gap-4 hover:shadow-md transition">
                <div class="p-3 rounded-xl bg-red-100 text-red-600 shrink-0">
                  <Droplet class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="font-bold text-lg text-gray-900 mb-1">Óleo de Motor</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">
                    Troca de óleo mineral, semissintético e sintético, respeitando rigorosamente as viscosidades e normas de cada montadora.
                  </p>
                </div>
              </div>
              
              <!-- Serviço 2 -->
              <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs flex items-start gap-4 hover:shadow-md transition">
                <div class="p-3 rounded-xl bg-red-100 text-red-600 shrink-0">
                  <Settings class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="font-bold text-lg text-gray-900 mb-1">Linha Completa de Filtros</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">
                    Substituição de filtros de óleo, ar do motor, ar-condicionado (cabine) e combustível para máxima proteção.
                  </p>
                </div>
              </div>

              <!-- Serviço 3 -->
              <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs flex items-start gap-4 hover:shadow-md transition">
                <div class="p-3 rounded-xl bg-red-100 text-red-600 shrink-0">
                  <Car class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="font-bold text-lg text-gray-900 mb-1">Fluidos Especiais</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">
                    Verificação e reposição de fluidos de transmissão, freio e arrefecimento, essenciais para a vida útil do conjunto mecânico.
                  </p>
                </div>
              </div>

              <!-- Serviço 4 -->
              <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs flex items-start gap-4 hover:shadow-md transition">
                <div class="p-3 rounded-xl bg-red-100 text-red-600 shrink-0">
                  <CheckCircle2 class="w-6 h-6" />
                </div>
                <div>
                  <h3 class="font-bold text-lg text-gray-900 mb-1">Check-up Preventivo</h3>
                  <p class="text-gray-600 text-sm leading-relaxed">
                    Atendimento ágil enquanto você aguarda com conforto na Conveniência {siteConfig.businesses.conveniencia.name}.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Marcas e Especialidades -->
          <div class="bg-red-50 border border-red-200 rounded-2xl p-8 shadow-xs">
            <div class="flex items-center gap-3 mb-4">
              <ShieldCheck class="w-8 h-8 text-red-600 shrink-0" />
              <h3 class="text-2xl font-bold text-gray-900">Qualidade e Precisão Técnica</h3>
            </div>
            <p class="text-gray-700 mb-6 leading-relaxed">
              Trabalhamos com linhas automotivas completas (linha leve e flex), <strong>SUVs e Utilitários a Diesel</strong>, e também temos experiência com filtros específicos para <strong>Motocicletas de alta cilindrada</strong>.
            </p>
            <div class="bg-white rounded-xl p-5 border border-red-100">
              <p class="text-xs uppercase tracking-wider text-gray-500 font-bold mb-3">
                Marcas parceiras e referências que você encontra aqui:
              </p>
              <div class="flex flex-wrap gap-2">
                {["Lubrificantes YPF Elaion", "Filtros MAHLE", "TECFIL", "WEGA", "MANN-FILTER"].map((brand) => (
                  <span class="bg-blue-950 text-white text-xs font-semibold px-3 py-1.5 rounded-lg">
                    {brand}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Barra Lateral: Cotação Rápida + Informações -->
        <aside class="w-full lg:w-2/5 space-y-6">
          <!-- Formulário de Cotação Rápida via WhatsApp -->
          <div class="bg-gray-50 p-6 sm:p-8 rounded-2xl border border-gray-200 shadow-xs">
            <h3 class="font-bold text-xl text-gray-900 mb-2">Cotação Rápida no WhatsApp</h3>
            <p class="text-sm text-gray-600 mb-6">
              Informe seu veículo para consultarmos o óleo e os filtros exatos no nosso estoque:
            </p>

            <form id="form-oleo" class="space-y-4">
              <div>
                <label for="veiculo" class="block text-xs font-bold uppercase text-gray-600 mb-1">
                  Veículo / Ano / Motorização
                </label>
                <input
                  type="text"
                  id="veiculo"
                  required
                  placeholder="Ex: Jeep Renegade 2021, Discovery Diesel, Moto..."
                  class="w-full bg-white rounded-xl border border-gray-300 px-3.5 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"
                />
              </div>

              <div>
                <label for="servico-oleo" class="block text-xs font-bold uppercase text-gray-600 mb-1">
                  O que deseja cotar?
                </label>
                <select
                  id="servico-oleo"
                  class="w-full bg-white rounded-xl border border-gray-300 px-3.5 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"
                >
                  <option value="Óleo do motor + Filtro de óleo" selected>Óleo do motor + Filtro de óleo</option>
                  <option value="Revisão completa (Óleo + Todos os filtros)">Revisão completa (Óleo + Todos os filtros)</option>
                  <option value="Apenas filtros (Óleo / Ar / Cabine / Combustível)">Apenas filtros (Óleo / Ar / Cabine / Combustível)</option>
                  <option value="Fluido de transmissão / Outros fluidos">Fluido de transmissão / Outros fluidos</option>
                </select>
              </div>

              <div>
                <label for="obs-oleo" class="block text-xs font-bold uppercase text-gray-600 mb-1">
                  Observações (Opcional)
                </label>
                <input
                  type="text"
                  id="obs-oleo"
                  placeholder="Ex: Viscosidade 5W30, código do filtro..."
                  class="w-full bg-white rounded-xl border border-gray-300 px-3.5 py-2.5 text-gray-900 text-sm focus:outline-none focus:ring-2 focus:ring-red-500"
                />
              </div>

              <button
                type="submit"
                class="w-full bg-green-600 hover:bg-green-700 text-white px-6 py-3.5 rounded-xl font-bold transition shadow-xs flex items-center justify-center gap-2 cursor-pointer"
              >
                <MessageCircle class="w-5 h-5" />
                <span>Consultar Valores no WhatsApp</span>
              </button>
            </form>
          </div>

          <!-- Card de Horário e Localização -->
          <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200">
            <h3 class="font-bold text-lg text-gray-900 mb-4">Atendimento</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <Clock class="w-5 h-5 text-blue-700 shrink-0 mt-0.5" />
                <div>
                  <h4 class="font-bold text-sm text-gray-900">Horário da Troca de Óleo</h4>
                  <p class="text-gray-600 text-sm">{siteConfig.businesses.trocaOleo.hours}</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <MapPin class="w-5 h-5 text-blue-700 shrink-0 mt-0.5" />
                <div>
                  <h4 class="font-bold text-sm text-gray-900">Localização</h4>
                  <p class="text-gray-600 text-sm">Estrutura anexa ao {siteConfig.name} — {siteConfig.address}</p>
                </div>
              </li>
            </ul>
          </div>
        </aside>

      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ whatsappNumber }}>
  const form = document.getElementById('form-oleo');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const veiculo = document.getElementById('veiculo')?.value || '';
    const servico = document.getElementById('servico-oleo')?.value || '';
    const obs = document.getElementById('obs-oleo')?.value || '';

    let mensagem =
      `Olá! Gostaria de uma cotação na *Troca de Óleo do Posto Intermares*:\n\n` +
      `🚗 *Veículo:* ${veiculo}\n` +
      `🔧 *Serviço:* ${servico}`;

    if (obs.trim()) {
      mensagem += `\n📝 *Obs:* ${obs.trim()}`;
    }

    const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensagem)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>