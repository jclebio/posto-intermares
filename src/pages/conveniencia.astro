---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import {
  Coffee,
  ShoppingBasket,
  ExternalLink,
  Clock,
  MapPin,
  Beer,
  IceCream,
  Sparkles,
  Navigation
} from '@lucide/astro';

const menuUrl = siteConfig.businesses.conveniencia.menuUrl || "https://cardapiohorah.duckdns.org/";
---

<Layout 
  title={`Conveniência ${siteConfig.businesses.conveniencia.name}`}
  description="Conveniência completa em Cabedelo. Lanches, bebidas geladas, produtos automotivos e muito mais."
>
  <!-- Hero Section -->
  <section class="bg-zinc-900 py-16 border-b-4 border-red-500 text-white">
       <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex p-4 rounded-2xl bg-red-500/15 border border-red-400/30 mb-6">
        <ShoppingBasket class="w-12 h-12 text-red-400" />
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Conveniência {siteConfig.businesses.conveniencia.name}
      </h1>
      <p class="text-xl text-zinc-300 max-w-2xl mx-auto leading-relaxed">
        A parada perfeita para o seu dia a dia ou para a sua viagem. Tudo o que você precisa, rápido, climatizado e prático.
      </p>
    </div>
  </section>

  <!-- Conteúdo Principal -->
  <section class="bg-white text-gray-900 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-12 items-start">
        
        <!-- Coluna Principal -->
        <div class="flex-1 space-y-8">
          <div>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">O que você encontra aqui</h2>
            <p class="text-gray-600">
              Ambiente confortável em Intermares para fazer um lanche, tomar um café ou garantir os itens da sua rotina.
            </p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Card Lanches -->
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs flex items-start gap-4 hover:shadow-md transition">
              <div class="p-3 rounded-xl bg-red-100 text-red-600 shrink-0">
                <Coffee class="w-6 h-6" />
              </div>
              <div>
                <h3 class="font-bold text-lg text-gray-900 mb-1">Lanches e Cafés</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                  Salgados, doces, chocolates e aquele café passado na hora para dar energia.
                </p>
              </div>
            </div>
            
            <!-- Card Bebidas -->
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs flex items-start gap-4 hover:shadow-md transition">
              <div class="p-3 rounded-xl bg-red-100 text-red-600 shrink-0">
                <Beer class="w-6 h-6" />
              </div>
              <div>
                <h3 class="font-bold text-lg text-gray-900 mb-1">Bebidas Geladas</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                  Cervejas, refrigerantes, energéticos, sucos e água sempre na temperatura ideal.
                </p>
              </div>
            </div>

            <!-- Card Sorvetes & Sobremesas -->
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs flex items-start gap-4 hover:shadow-md transition">
              <div class="p-3 rounded-xl bg-red-100 text-red-600 shrink-0">
                <IceCream class="w-6 h-6" />
              </div>
              <div>
                <h3 class="font-bold text-lg text-gray-900 mb-1">Sorvetes e Bomboniere</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                  Opções refrescantes, biscoitos, snacks e petiscos para acompanhar sua viagem ou praia.
                </p>
              </div>
            </div>

            <!-- Card Conveniência Geral -->
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 shadow-xs flex items-start gap-4 hover:shadow-md transition">
              <div class="p-3 rounded-xl bg-red-100 text-red-600 shrink-0">
                <Sparkles class="w-6 h-6" />
              </div>
              <div>
                <h3 class="font-bold text-lg text-gray-900 mb-1">Conveniência Rápida</h3>
                <p class="text-gray-600 text-sm leading-relaxed">
                  Gelo, carvão, itens de última hora e atendimento rápido com pagamento via Pix e cartões.
                </p>
              </div>
            </div>
          </div>

          <!-- Call to Action: Cardápio Digital -->
          <div class="bg-red-50 border border-red-200 rounded-2xl p-8 mt-8 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6 shadow-xs">
            <div>
              <span class="inline-block text-xs font-bold uppercase tracking-wider text-red-700 bg-red-100 px-3 py-1 rounded-full mb-2">
                Cardápio Online
              </span>
              <h3 class="text-2xl font-bold text-gray-900 mb-2">Consulte preços e opções</h3>
              <p class="text-gray-700 max-w-lg leading-relaxed">
                Acesse nosso cardápio digital completo para conferir as opções de lanches, bebidas e promoções disponíveis na Conveniência {siteConfig.businesses.conveniencia.name}.
              </p>
            </div>
            <a 
              href={menuUrl}
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-red-600 text-white px-8 py-4 rounded-xl font-bold hover:bg-red-700 transition shadow-sm hover:shadow-md shrink-0"
            >
              <span>Ver Cardápio Digital</span>
              <ExternalLink class="w-5 h-5" />
            </a>
          </div>
        </div>

        <!-- Barra Lateral Informativa -->
        <aside class="w-full lg:w-1/3 bg-gray-50 p-6 sm:p-8 rounded-2xl border border-gray-200 space-y-6">
          <h3 class="font-bold text-xl text-gray-900">Informações</h3>
          
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="p-2.5 rounded-xl bg-zinc-100 text-zinc-700 shrink-0">
                <Clock class="w-5 h-5" />
              </div>
              <div>
                <h4 class="font-bold text-gray-900">Horário de Funcionamento</h4>
                <p class="text-gray-600 text-sm mt-1">{siteConfig.businesses.conveniencia.hours}</p>
              </div>
            </li>
            
            <li class="flex items-start gap-4">
              <div class="p-2.5 rounded-xl bg-zinc-100 text-zinc-700 shrink-0">
                <MapPin class="w-5 h-5" />
              </div>
              <div>
                <h4 class="font-bold text-gray-900">Localização</h4>
                <p class="text-gray-600 text-sm mt-1">
                  Anexa ao {siteConfig.name}<br />
                  {siteConfig.address}
                </p>
              </div>
            </li>
          </ul>

          <div class="pt-4 border-t border-gray-200 flex flex-col gap-3">
            <a
              href={siteConfig.mapsLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 bg-zinc-900 text-white px-4 py-3 rounded-xl font-semibold hover:bg-zinc-800 transition text-sm"
            >
              <Navigation class="w-4 h-4 text-red-400" />
              <span>Como Chegar (Google Maps)</span>
            </a>
          </div>
        </aside>

      </div>
    </div>
  </section>
</Layout>