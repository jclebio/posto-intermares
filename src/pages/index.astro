---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import {
  Fuel,
  Coffee,
  Bed,
  Wrench,
  WashingMachine,
  Landmark,
  ShieldCheck,
  MapPin,
  Clock,
  ArrowRight,
  ExternalLink,
  CheckCircle2,
  Navigation
} from '@lucide/astro';

const whatsappPousadaUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent(siteConfig.businesses.pousada.bookingMessage)}`;
const wazeUrl = siteConfig.wazeLink || "https://waze.com/ul?q=Av.%20Mar%20Vermelho%2C%20499%20-%20Intermares%2C%20Cabedelo";
---

<Layout title="Início">
<!-- Hero Section -->
  <section class="relative bg-zinc-900 text-white overflow-hidden">
    <!-- Película mais leve para deixar a imagem de fundo mais clara e visível -->
    <div class="absolute inset-0 bg-gradient-to-r from-zinc-950/70 via-zinc-950/50 to-zinc-950/30 z-10"></div>
    
    <!-- Imagem de fundo real -->
    <div class="absolute inset-0 bg-[url('/hero-placeholder.jpg')] bg-cover bg-center"></div>
    
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 flex flex-col items-center text-center">
      <span class="inline-flex items-center gap-2 bg-red-600/30 border border-red-500/50 text-red-100 text-xs sm:text-sm font-semibold px-4 py-1.5 rounded-full mb-6 backdrop-blur-xs">
        <MapPin class="w-4 h-4 text-red-400" /> Complexo de Serviços em Intermares, Cabedelo/PB
      </span>

      <h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4 drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]">
        Muito mais que um posto.
      </h1>

      <p class="text-lg md:text-xl max-w-2xl text-zinc-100 mb-8 leading-relaxed drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
        No {siteConfig.name}, você encontra abastecimento, descanso, conveniência e serviços automotivos no mesmo lugar, em Cabedelo.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto justify-center">
        <a
          href="#servicos"
          class="bg-white text-zinc-900 px-6 py-3.5 rounded-xl font-semibold hover:bg-zinc-100 transition shadow-lg"
        >
          Conhecer Serviços
        </a>
        <a
          href="/pousada-do-sol"
          class="bg-red-600 text-white px-6 py-3.5 rounded-xl font-semibold hover:bg-red-700 transition shadow-lg shadow-red-950/50"
        >
          Ver {siteConfig.businesses.pousada.name}
        </a>
      </div>
    </div>
  </section>

  <!-- Faixa de Abastecimento & Diferenciais da Pista -->
  <section class="bg-zinc-950 border-b border-zinc-800 text-zinc-100 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="flex items-start gap-4">
          <div class="p-3 rounded-xl bg-red-600/15 text-red-500 shrink-0">
            <Fuel class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-bold text-white text-base">Abastecimento de Confiança</h2>
            <p class="text-sm text-zinc-400 mt-1">
              Combustíveis com rigoroso controle de qualidade e atendimento ágil na pista.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="p-3 rounded-xl bg-red-600/15 text-red-500 shrink-0">
            <Landmark class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-bold text-white text-base">Facilidade no Pagamento</h2>
            <p class="text-sm text-zinc-400 mt-1">
              Aceitamos Pix, cartões de débito e crédito com rapidez e praticidade.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="p-3 rounded-xl bg-red-600/15 text-red-500 shrink-0">
            <ShieldCheck class="w-6 h-6" />
          </div>
          <div>
            <h2 class="font-bold text-white text-base">Estrutura Completa</h2>
            <p class="text-sm text-zinc-400 mt-1">
              Conveniência Hora H, Pousada do Sol, Troca de Óleo e Lavanderia no mesmo local.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pousada Highlight -->
  <section class="py-16 bg-white text-zinc-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-zinc-50 rounded-2xl p-8 md:p-12 flex flex-col md:flex-row items-center gap-8 border border-zinc-200 shadow-xs">
        <div class="flex-1">
          <div class="inline-flex items-center gap-2 bg-red-100 text-red-700 text-sm font-bold px-3 py-1 rounded-full mb-4">
            <Bed class="w-4 h-4" /> Destaque
          </div>

          <h2 class="text-3xl font-bold text-zinc-900 mb-4">
            {siteConfig.businesses.pousada.name}
          </h2>

          <p class="text-zinc-600 mb-6 text-lg leading-relaxed">
            Hospedagem prática e confortável anexa ao posto. Temos {siteConfig.businesses.pousada.rooms} quartos equipados com ar-condicionado e banheiro privativo para o seu descanso.
          </p>

          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mb-8 text-sm text-zinc-700 font-medium">
            {siteConfig.businesses.pousada.amenities.map((amenity) => (
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-red-600 shrink-0" />
                <span>{amenity}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-4">
            <a
              href="/pousada-do-sol"
              class="inline-flex items-center gap-2 bg-red-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-red-700 transition"
            >
              <span>Detalhes e Reservas</span>
              <ArrowRight class="w-4 h-4" />
            </a>
            <a
              href={whatsappPousadaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-white text-zinc-800 border border-zinc-300 px-6 py-3 rounded-xl font-semibold hover:bg-zinc-100 transition"
            >
              Consultar no WhatsApp
            </a>
          </div>
        </div>

        <div class="flex-1 w-full overflow-hidden rounded-2xl h-64 md:h-80 shadow-sm bg-zinc-200">
          <img
            src="/camas.jpg"
            alt={`Quarto da ${siteConfig.businesses.pousada.name}`}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Grade de Serviços -->
  <section id="servicos" class="py-16 bg-zinc-100 text-zinc-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-zinc-900 mb-3">Tudo no Mesmo Endereço</h2>
        <p class="text-zinc-600">
          Confira os horários e serviços disponíveis no complexo do {siteConfig.name}.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Conveniência -->
        <a
          href="/conveniencia"
          class="group bg-white p-7 rounded-2xl shadow-xs hover:shadow-md transition border border-zinc-200/80 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-5">
              <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center group-hover:bg-red-600 group-hover:text-white transition-colors">
                <Coffee class="w-6 h-6" />
              </div>
              <span class="inline-flex items-center gap-1 text-xs font-medium bg-zinc-100 text-zinc-700 px-2.5 py-1 rounded-full">
                <Clock class="w-3.5 h-3.5 text-red-600 shrink-0" />
                {siteConfig.businesses.conveniencia.hours}
              </span>
            </div>

            <h3 class="text-xl font-bold text-zinc-900 mb-2">
              Conveniência {siteConfig.businesses.conveniencia.name}
            </h3>
            <p class="text-zinc-600 leading-relaxed mb-6">
              {siteConfig.businesses.conveniencia.description}
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-900 group-hover:text-red-600 transition-colors">
            <span>Conhecer conveniência</span>
            <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </span>
        </a>

        <!-- Troca de Óleo -->
        <a
          href="/troca-de-oleo"
          class="group bg-white p-7 rounded-2xl shadow-xs hover:shadow-md transition border border-zinc-200/80 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-5">
              <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center group-hover:bg-red-600 group-hover:text-white transition-colors">
                <Wrench class="w-6 h-6" />
              </div>
              <span class="inline-flex items-center gap-1 text-xs font-medium bg-zinc-100 text-zinc-700 px-2.5 py-1 rounded-full">
                <Clock class="w-3.5 h-3.5 text-red-600 shrink-0" />
                {siteConfig.businesses.trocaOleo.hours}
              </span>
            </div>

            <h3 class="text-xl font-bold text-zinc-900 mb-2">
              {siteConfig.businesses.trocaOleo.name}
            </h3>
            <p class="text-zinc-600 leading-relaxed mb-6">
              Manutenção preventiva, lubrificantes de qualidade e atendimento especializado.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-900 group-hover:text-red-600 transition-colors">
            <span>Ver serviços e cotar</span>
            <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
          </span>
        </a>

        <!-- Lavanderia -->
        <a
          href={siteConfig.businesses.lavanderia.instagramUrl || "https://www.instagram.com/lavointermares/"}
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-white p-7 rounded-2xl shadow-xs hover:shadow-md transition border border-zinc-200/80 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-5">
              <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center group-hover:bg-red-600 group-hover:text-white transition-colors">
                <WashingMachine class="w-6 h-6" />
              </div>
              <span class="inline-flex items-center gap-1 text-xs font-medium bg-zinc-100 text-zinc-700 px-2.5 py-1 rounded-full">
                <Clock class="w-3.5 h-3.5 text-red-600 shrink-0" />
                {siteConfig.businesses.lavanderia.hours}
              </span>
            </div>

            <h3 class="text-xl font-bold text-zinc-900 mb-2">
              {siteConfig.businesses.lavanderia.name}
            </h3>
            <p class="text-zinc-600 leading-relaxed mb-6">
              Roupas limpas com praticidade enquanto você utiliza nossos outros serviços.
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-zinc-900 group-hover:text-red-600 transition-colors">
            <span>Ver no Instagram</span>
            <ExternalLink class="w-4 h-4" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Faixa de Localização Rápida -->
  <section class="py-12 bg-white border-t border-zinc-200 text-zinc-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-zinc-900 text-white rounded-2xl p-8 flex flex-col lg:flex-row items-center justify-between gap-6 border-l-4 border-red-600">
        <div class="flex items-start gap-4">
          <div class="p-3 rounded-xl bg-red-600 text-white shrink-0 mt-1">
            <MapPin class="w-6 h-6" />
          </div>
          <div>
            <h2 class="text-2xl font-bold mb-1">Fácil acesso em Intermares</h2>
            <p class="text-zinc-300">{siteConfig.address}</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 w-full lg:w-auto justify-center">
          <a
            href={siteConfig.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-white text-zinc-900 px-5 py-3 rounded-xl font-semibold hover:bg-zinc-100 transition flex-1 sm:flex-initial"
          >
            <MapPin class="w-4 h-4 text-red-600" />
            <span>Abrir no Google Maps</span>
          </a>
          <a
            href={wazeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-zinc-800 text-white border border-zinc-700 px-5 py-3 rounded-xl font-semibold hover:bg-zinc-700 transition flex-1 sm:flex-initial"
          >
            <Navigation class="w-4 h-4 text-red-500" />
            <span>Ir com Waze</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>