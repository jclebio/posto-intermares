---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import {
  Check,
  Calendar,
  Bed,
  Coffee,
  ShieldCheck,
  MapPin,
  MessageCircle
} from '@lucide/astro';

const whatsappNumber = siteConfig.contact.whatsapp;
const whatsappFallbackUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(siteConfig.businesses.pousada.bookingMessage)}`;
---

<Layout 
  title={siteConfig.businesses.pousada.name}
  description="Hospedagem prática em Cabedelo. Quartos com ar-condicionado e banheiro privativo anexos ao Posto Intermares."
>
  <!-- Cabeçalho da Página -->
  <section class="bg-zinc-900 py-16 border-b-4 border-red-600 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex p-4 rounded-2xl bg-red-600/15 border border-red-500/30 mb-6">
        <Bed class="w-12 h-12 text-red-500" />
      </div>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
        {siteConfig.businesses.pousada.name}
      </h1>
      <p class="text-xl text-zinc-300 max-w-3xl mx-auto leading-relaxed">
        Uma opção prática de hospedagem em Cabedelo para quem está viajando a trabalho, conhecendo a região ou precisa de um lugar confortável e seguro para descansar.
      </p>
    </div>
  </section>

  <!-- Conteúdo Principal -->
  <section class="bg-white text-zinc-900 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row gap-12">
      
      <!-- Coluna Esquerda: Informações + Formulário de Reserva -->
      <div class="flex-1">
        <h2 class="text-2xl font-bold text-zinc-900 mb-4">Nossas Acomodações</h2>
        <p class="text-zinc-600 mb-6 text-lg leading-relaxed">
          Contamos com <strong>{siteConfig.businesses.pousada.rooms} quartos</strong> projetados para oferecer o essencial para uma excelente noite de sono, com toda a conveniência da estrutura do {siteConfig.name}.
        </p>
        
        <!-- Lista de Comodidades -->
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          {siteConfig.businesses.pousada.amenities.map((amenity) => (
            <li class="flex items-center gap-3 text-zinc-800 font-medium bg-zinc-50 p-3 rounded-xl border border-zinc-200/80">
              <div class="bg-red-100 p-1.5 rounded-full text-red-600 shrink-0">
                <Check class="w-4 h-4" />
              </div>
              <span>{amenity}</span>
            </li>
          ))}
        </ul>

        <!-- Diferenciais de estar anexo ao Posto -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200 flex items-start gap-3">
            <Coffee class="w-5 h-5 text-red-600 shrink-0 mt-0.5" />
            <div>
              <h3 class="font-bold text-sm text-zinc-900">Conveniência {siteConfig.businesses.conveniencia.name}</h3>
              <p class="text-xs text-zinc-600 mt-0.5">
                Lanches, café e bebidas a poucos passos do seu quarto ({siteConfig.businesses.conveniencia.hours}).
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200 flex items-start gap-3">
            <ShieldCheck class="w-5 h-5 text-red-600 shrink-0 mt-0.5" />
            <div>
              <h3 class="font-bold text-sm text-zinc-900">Localização Estratégica</h3>
              <p class="text-xs text-zinc-600 mt-0.5">
                Fácil acesso na {siteConfig.address}, com estacionamento e serviços no local.
              </p>
            </div>
          </div>
        </div>

        <!-- Card de Reservas Diretas (Interativo) -->
        <div class="bg-zinc-50 p-6 sm:p-8 rounded-2xl border border-zinc-200 shadow-xs">
          <h3 class="font-bold text-xl text-zinc-900 mb-2 flex items-center gap-2">
            <Calendar class="w-5 h-5 text-red-600" /> Reservas Diretas
          </h3>
          <p class="text-zinc-600 mb-6 text-sm">
            O atendimento para reservas é feito diretamente via WhatsApp da administração do posto. Preencha os dados abaixo para agilizar sua consulta:
          </p>

          <form id="form-pousada" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="checkin" class="block text-xs font-bold uppercase text-zinc-600 mb-1">
                  Data de Entrada (Check-in)
                </label>
                <input
                  type="date"
                  id="checkin"
                  required
                  class="w-full bg-white rounded-xl border border-zinc-300 px-3.5 py-2.5 text-zinc-900 focus:outline-none focus:ring-2 focus:ring-red-600"
                />
              </div>
              <div>
                <label for="checkout" class="block text-xs font-bold uppercase text-zinc-600 mb-1">
                  Data de Saída (Check-out)
                </label>
                <input
                  type="date"
                  id="checkout"
                  required
                  class="w-full bg-white rounded-xl border border-zinc-300 px-3.5 py-2.5 text-zinc-900 focus:outline-none focus:ring-2 focus:ring-red-600"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="hospedes" class="block text-xs font-bold uppercase text-zinc-600 mb-1">
                  Quantidade de Hóspedes
                </label>
                <select
                  id="hospedes"
                  class="w-full bg-white rounded-xl border border-zinc-300 px-3.5 py-2.5 text-zinc-900 focus:outline-none focus:ring-2 focus:ring-red-600"
                >
                  <option value="1 hóspede">1 hóspede</option>
                  <option value="2 hóspedes" selected>2 hóspedes</option>
                  <option value="3 hóspedes">3 hóspedes</option>
                  <option value="4 ou mais hóspedes">4 ou mais hóspedes</option>
                </select>
              </div>

              <div>
                <label for="quartos" class="block text-xs font-bold uppercase text-zinc-600 mb-1">
                  Quartos Desejados
                </label>
                <select
                  id="quartos"
                  class="w-full bg-white rounded-xl border border-zinc-300 px-3.5 py-2.5 text-zinc-900 focus:outline-none focus:ring-2 focus:ring-red-600"
                >
                  <option value="1 quarto" selected>1 quarto</option>
                  <option value="2 quartos">2 quartos</option>
                  <option value="3 ou mais quartos">3 ou mais quartos</option>
                </select>
              </div>
            </div>

            <button
              type="submit"
              class="w-full bg-green-600 hover:bg-green-700 text-white px-6 py-3.5 rounded-xl font-semibold transition flex items-center justify-center gap-2 cursor-pointer shadow-xs"
            >
              <MessageCircle class="w-5 h-5" />
              <span>Consultar Disponibilidade no WhatsApp</span>
            </button>

            <div class="text-center pt-1">
              <a
                href={whatsappFallbackUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs text-zinc-500 hover:text-red-600 underline transition"
              >
                Ainda não definiu as datas? Clique aqui para falar direto no WhatsApp
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Coluna Direita: Galeria de Fotos -->
      <div class="flex-1">
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2 relative overflow-hidden rounded-2xl h-64 sm:h-80 shadow-xs group bg-zinc-100">
            <img
              src="/camas.jpg"
              alt="Quarto climatizado da Pousada do Sol"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="eager"
            />
            <span class="absolute bottom-3 left-3 bg-zinc-900/80 backdrop-blur-xs text-white text-xs font-medium px-3 py-1 rounded-full">
              Acomodações climatizadas
            </span>
          </div>

          <div class="relative overflow-hidden rounded-2xl h-44 sm:h-52 shadow-xs group bg-zinc-100">
            <img
              src="/banheiro.jpg"
              alt="Banheiro privativo da Pousada do Sol"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <span class="absolute bottom-2.5 left-2.5 bg-zinc-900/80 backdrop-blur-xs text-white text-xs font-medium px-2.5 py-1 rounded-full">
              Banheiro privativo
            </span>
          </div>

          <div class="relative overflow-hidden rounded-2xl h-44 sm:h-52 shadow-xs group bg-zinc-100">
            <img
              src="/banheiro1.jpg"
              alt="Detalhes do banheiro privativo da Pousada do Sol"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
            <span class="absolute bottom-2.5 left-2.5 bg-zinc-900/80 backdrop-blur-xs text-white text-xs font-medium px-2.5 py-1 rounded-full">
              Conforto e higiene
            </span>
          </div>
        </div>

        <p class="text-xs text-zinc-500 mt-4 text-center">
          * Fotos ilustrativas aguardando material fotográfico oficial.
        </p>

        <div class="mt-6 p-5 rounded-2xl bg-zinc-50 border border-zinc-200 flex items-center justify-between gap-4">
          <div class="flex items-start gap-3">
            <MapPin class="w-5 h-5 text-red-600 shrink-0 mt-0.5" />
            <div>
              <h4 class="font-bold text-sm text-zinc-900">Onde estamos</h4>
              <p class="text-xs text-zinc-600">{siteConfig.address}</p>
            </div>
          </div>
          <a
            href={siteConfig.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold bg-white text-zinc-900 border border-zinc-300 px-3.5 py-2 rounded-lg hover:bg-zinc-100 transition shrink-0"
          >
            Ver no Mapa
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script define:vars={{ whatsappNumber }}>
  const checkinInput = document.getElementById('checkin');
  const checkoutInput = document.getElementById('checkout');
  const form = document.getElementById('form-pousada');

  const today = new Date().toISOString().split('T')[0];
  if (checkinInput && checkoutInput) {
    checkinInput.min = today;
    checkoutInput.min = today;

    checkinInput.addEventListener('change', () => {
      if (checkinInput.value) {
        checkoutInput.min = checkinInput.value;
        if (checkoutInput.value && checkoutInput.value < checkinInput.value) {
          checkoutInput.value = checkinInput.value;
        }
      }
    });
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const checkinRaw = checkinInput?.value || '';
    const checkoutRaw = checkoutInput?.value || '';
    const hospedes = document.getElementById('hospedes')?.value || '';
    const quartos = document.getElementById('quartos')?.value || '';

    const formatarData = (dataStr) => {
      if (!dataStr) return '';
      const [ano, mes, dia] = dataStr.split('-');
      return `${dia}/${mes}/${ano}`;
    };

    const mensagem =
      `Olá! Gostaria de consultar a disponibilidade da *Pousada do Sol*:\n\n` +
      `📅 *Data de entrada:* ${formatarData(checkinRaw)}\n` +
      `📅 *Data de saída:* ${formatarData(checkoutRaw)}\n` +
      `👥 *Hóspedes:* ${hospedes} (${quartos})`;

    const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(mensagem)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>