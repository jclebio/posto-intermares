---
import { siteConfig } from '../config/site';
---

<footer class="bg-blue-900 text-blue-50 py-12 mt-auto border-t-4 border-orange-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Sobre o Posto -->
      <div>
        <h3 class="text-xl font-bold text-white mb-4">{siteConfig.name}</h3>
        <p class="text-blue-200 text-sm mb-4">
          {siteConfig.description}
        </p>
      </div>

      <!-- Contatos e Localização -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">Contato & Localização</h3>
        <ul class="space-y-3 text-sm text-blue-200">
          <li>
            <a href={siteConfig.mapsLink} target="_blank" rel="noopener noreferrer" class="hover:text-white transition">
              {siteConfig.address}
            </a>
          </li>
          <li>
            WhatsApp: <a href={`https://wa.me/${siteConfig.contact.whatsapp}`} class="hover:text-white transition">{siteConfig.contact.whatsapp}</a>
          </li>
          <li>Telefone: {siteConfig.contact.phone}</li>
          <li>Email: {siteConfig.contact.email}</li>
        </ul>
      </div>

      <!-- Links Rápidos -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">Nossos Serviços</h3>
        <ul class="space-y-2 text-sm text-blue-200">
          <li><a href="/" class="hover:text-white transition">Início</a></li>
          <li><a href="/pousada-do-sol" class="hover:text-white transition">{siteConfig.businesses.pousada.name}</a></li>
          <li><a href="/conveniencia" class="hover:text-white transition">Conveniência {siteConfig.businesses.conveniencia.name}</a></li>
          <li><a href="/troca-de-oleo" class="hover:text-white transition">Troca de Óleo</a></li>
          <li><a href="https://www.instagram.com/lavointermares/" class="hover:text-white transition">Lavanderia</a></li>
        </ul>
      </div>

    </div>

    <!-- Copyright -->
    <div class="border-t border-blue-800 mt-12 pt-8 text-center text-sm text-blue-400">
      &copy; {new Date().getFullYear()} {siteConfig.name}. Todos os direitos reservados.
    </div>
  </div>
</footer>