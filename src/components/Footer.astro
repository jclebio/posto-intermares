---
import { siteConfig } from '../config/site';
import { MapPin, Phone, Mail, MessageCircle, ExternalLink } from '@lucide/astro';
---

<footer class="bg-zinc-900 text-zinc-100 py-12 mt-auto border-t-4 border-red-600">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Sobre o Posto -->
      <div>
        <h3 class="text-xl font-bold text-white mb-4">{siteConfig.name}</h3>
        <p class="text-zinc-400 text-sm mb-4 leading-relaxed">
          {siteConfig.description}
        </p>
      </div>

      <!-- Contatos e Localização -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">Contato & Localização</h3>
        <ul class="space-y-3 text-sm text-zinc-300">
          <li>
            <a
              href={siteConfig.mapsLink}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-start gap-2 hover:text-white transition"
            >
              <MapPin class="w-4 h-4 text-red-500 shrink-0 mt-0.5" />
              <span>{siteConfig.address}</span>
            </a>
          </li>
          <li>
            <a
              href={`https://wa.me/${siteConfig.contact.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-white transition"
            >
              <MessageCircle class="w-4 h-4 text-red-500 shrink-0" />
              <span>WhatsApp: {siteConfig.contact.phone}</span>
            </a>
          </li>
          <li>
            <a
              href={`tel:+${siteConfig.contact.whatsapp}`}
              class="inline-flex items-center gap-2 hover:text-white transition"
            >
              <Phone class="w-4 h-4 text-red-500 shrink-0" />
              <span>Telefone: {siteConfig.contact.phone}</span>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="inline-flex items-center gap-2 hover:text-white transition"
            >
              <Mail class="w-4 h-4 text-red-500 shrink-0" />
              <span>Email: {siteConfig.contact.email}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Links Rápidos -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">Nossos Serviços</h3>
        <ul class="space-y-2 text-sm text-zinc-300">
          <li><a href="/" class="hover:text-white transition">Início</a></li>
          <li><a href="/pousada-do-sol" class="hover:text-white transition">{siteConfig.businesses.pousada.name}</a></li>
          <li><a href="/conveniencia" class="hover:text-white transition">Conveniência {siteConfig.businesses.conveniencia.name}</a></li>
	  <li><a href="/agua-e-gas" class="hover:text-white transition">Àgua e Gás</a></li>
          <li><a href="/troca-de-oleo" class="hover:text-white transition">Troca de Óleo</a></li>
          <li>
            <a
              href={siteConfig.businesses.lavanderia.instagramUrl || "https://www.instagram.com/lavointermares/"}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-white transition"
            >
              <span>Lavanderia</span>
              <ExternalLink class="w-3.5 h-3.5 text-zinc-400" />
            </a>
          </li>
          <li><a href="/contato" class="hover:text-white transition">Contato & Localização</a></li>

        </ul>
      </div>

    </div>

    <!-- Copyright -->
    <div class="border-t border-zinc-800 mt-12 pt-8 text-center text-sm text-zinc-500">
      &copy; {new Date().getFullYear()} {siteConfig.name}. Todos os direitos reservados.
    </div>
  </div>
</footer>